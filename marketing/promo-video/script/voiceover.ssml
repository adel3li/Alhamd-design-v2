<speak>
<prosody rate="92%">
  النِّعمةُ لا تُرى
  <break time="1000ms"/>
  حتى تغيب.
  <break time="1000ms"/>
  تستيقظُ كلَّ صباحٍ فترى النُّور،
  <break time="1000ms"/>
  وتشربُ ماءً باردًا،
  <break time="1000ms"/>
  وتسمعُ صوتًا تُحِبُّه،
  <break time="1000ms"/>
  وتمشي على قدميكَ إلى حيثُ تشاء
  <break time="1000ms"/>
  ولا تلتفت.
  <break time="1000ms"/>
  فالنِّعمةُ إذا دامت صارت عادة<break time="450ms"/> والعادةُ لا تُشكَر.
  <break time="1000ms"/>
  فتخيَّلْ<break time="450ms"/> لو غابت.
  <break time="1000ms"/>
  ثمَّ عُدْ
  <break time="1000ms"/>
  فتجدَها ما زالت بين يديك.
  <break time="1000ms"/>
  <prosody rate="80%">الحمدُ لله.</prosody>
  <break time="1000ms"/>
  تطبيقُ الحمد<break time="450ms"/> يُعيدُ إليكَ النَّظر.
  <break time="1000ms"/>
  كلَّ يومٍ نعمةٌ واحدة<break time="450ms"/> بآيتِها وتدبُّرِها،
  <break time="1000ms"/>
  ودقيقتانِ من التأمُّل<break time="450ms"/> تحمدُ بعدها بقلبٍ حاضر.
  <break time="1000ms"/>
  وسجلٌّ لحمدِك، ومِسبحةٌ، ورحلةٌ مع النِّعَم<break time="450ms"/> تشاركُها مع من تُحِبّ.
  <break time="1000ms"/>
  بلا حساب، ولا إعلانات<break time="450ms"/> وما تكتبُه لا يغادرُ جهازَك.
  <break time="1000ms"/>
  كم نعمةً مرَّت بك اليوم؟ ابدأْ بواحدة.
  <break time="1000ms"/>
  الحمد<break time="450ms"/> نعمةٌ كلَّ يوم.
  <break time="1000ms"/>
</prosody>
</speak>
