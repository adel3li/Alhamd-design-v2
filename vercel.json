{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.alhamd.app"
        }
      ],
      "destination": "https://alhamd.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "alhamd.app"
        }
      ],
      "destination": "/landing/index.html"
    }
  ]
}
